{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/options-study.schema.json",
  "title": "Prediction-market options study snapshot",
  "description": "Versioned logical envelope for matched threshold-market and listed-options study records. Synthetic examples only; this schema grants no data-use rights.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "synthetic_fixture", "manifest", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "study_id": {"type": "string", "minLength": 1},
    "synthetic_fixture": {"type": "boolean"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/pmThresholdQuote"},
          {"$ref": "#/$defs/listedOptionQuote"},
          {"$ref": "#/$defs/normalizedMatch"},
          {"$ref": "#/$defs/derivedEstimate"}
        ]
      }
    }
  },
  "$defs": {
    "rightsStatus": {"enum": ["approved", "blocked", "unresolved", "not_applicable"]},
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "internal_research", "raw_storage", "derived_data", "team_sharing", "dashboard_display", "commercial_use", "basis", "reviewed_at"],
      "properties": {
        "access": {"$ref": "#/$defs/rightsStatus"},
        "internal_research": {"$ref": "#/$defs/rightsStatus"},
        "raw_storage": {"$ref": "#/$defs/rightsStatus"},
        "derived_data": {"$ref": "#/$defs/rightsStatus"},
        "team_sharing": {"$ref": "#/$defs/rightsStatus"},
        "dashboard_display": {"$ref": "#/$defs/rightsStatus"},
        "commercial_use": {"$ref": "#/$defs/rightsStatus"},
        "basis": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_id", "documentation_url", "access_method", "terms_reviewed_at", "rights"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "documentation_url": {"type": ["string", "null"], "format": "uri"},
        "access_method": {"type": "string", "minLength": 1},
        "terms_reviewed_at": {"type": "string", "format": "date"},
        "rights": {"$ref": "#/$defs/rights"}
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bid", "ask", "bid_size", "ask_size", "currency", "quote_time_utc", "received_at_utc", "timezone"],
      "properties": {
        "bid": {"type": ["number", "null"], "minimum": 0},
        "ask": {"type": ["number", "null"], "minimum": 0},
        "bid_size": {"type": ["number", "null"], "minimum": 0},
        "ask_size": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "quote_time_utc": {"type": "string", "format": "date-time"},
        "received_at_utc": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "baseRecord": {
      "type": "object",
      "required": ["record_id", "record_type", "data_status", "source", "observed_at_utc"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "data_status": {"enum": ["observed", "synthetic"]},
        "source": {"$ref": "#/$defs/source"},
        "observed_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "pmThresholdQuote": {
      "allOf": [
        {"$ref": "#/$defs/baseRecord"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_id", "record_type", "data_status", "source", "observed_at_utc", "venue", "event_id", "market_id", "contract_id", "underlying", "strike", "expiry", "event_definition", "yes_quote"],
          "properties": {
            "record_id": {"type": "string"},
            "record_type": {"const": "pm_threshold_quote"},
            "data_status": {"enum": ["observed", "synthetic"]},
            "source": {"$ref": "#/$defs/source"},
            "observed_at_utc": {"type": "string", "format": "date-time"},
            "venue": {"type": "string"},
            "event_id": {"type": "string"},
            "market_id": {"type": "string"},
            "contract_id": {"type": "string"},
            "underlying": {"type": "string"},
            "strike": {"type": "number", "exclusiveMinimum": 0},
            "expiry": {"type": "string", "format": "date"},
            "event_definition": {
              "type": "object", "additionalProperties": false,
              "required": ["comparison", "observation_time", "timezone", "resolution_source", "rule_version", "payout"],
              "properties": {
                "comparison": {"enum": ["strictly_above", "at_or_above"]},
                "observation_time": {"type": "string", "format": "date-time"},
                "timezone": {"type": "string"},
                "resolution_source": {"type": "string"},
                "rule_version": {"type": "string"},
                "payout": {"type": "number", "exclusiveMinimum": 0}
              }
            },
            "yes_quote": {"$ref": "#/$defs/quote"},
            "no_quote": {"$ref": "#/$defs/quote"}
          }
        }
      ]
    },
    "listedOptionQuote": {
      "allOf": [
        {"$ref": "#/$defs/baseRecord"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["record_id", "record_type", "data_status", "source", "observed_at_utc", "venue", "option_id", "underlying", "right", "strike", "expiry", "exercise_style", "settlement_style", "multiplier", "quote"],
          "properties": {
            "record_id": {"type": "string"},
            "record_type": {"const": "listed_option_quote"},
            "data_status": {"enum": ["observed", "synthetic"]},
            "source": {"$ref": "#/$defs/source"},
            "observed_at_utc": {"type": "string", "format": "date-time"},
            "venue": {"type": "string"},
            "option_id": {"type": "string"},
            "underlying": {"type": "string"},
            "right": {"enum": ["call", "put"]},
            "strike": {"type": "number", "exclusiveMinimum": 0},
            "expiry": {"type": "string", "format": "date"},
            "exercise_style": {"enum": ["european", "american", "other"]},
            "settlement_style": {"enum": ["cash", "physical", "other"]},
            "multiplier": {"type": "number", "exclusiveMinimum": 0},
            "quote": {"$ref": "#/$defs/quote"}
          }
        }
      ]
    },
    "normalizedMatch": {
      "allOf": [
        {"$ref": "#/$defs/baseRecord"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["record_id", "record_type", "data_status", "source", "observed_at_utc", "pm_record_id", "option_record_ids", "reference_price", "forward_price", "rates", "dividends_or_carry", "max_quote_skew_seconds", "match_status", "quality_flags"],
          "properties": {
            "record_id": {"type": "string"},
            "record_type": {"const": "normalized_match"},
            "data_status": {"enum": ["observed", "synthetic"]},
            "source": {"$ref": "#/$defs/source"},
            "observed_at_utc": {"type": "string", "format": "date-time"},
            "pm_record_id": {"type": "string"},
            "option_record_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "reference_price": {"type": "number", "exclusiveMinimum": 0},
            "forward_price": {"type": "number", "exclusiveMinimum": 0},
            "rates": {"type": "object", "required": ["risk_free_rate", "day_count"], "properties": {"risk_free_rate": {"type": "number"}, "day_count": {"type": "string"}}},
            "dividends_or_carry": {"type": "object", "required": ["yield_or_carry", "method"], "properties": {"yield_or_carry": {"type": "number"}, "method": {"type": "string"}}},
            "max_quote_skew_seconds": {"type": "number", "minimum": 0},
            "match_status": {"enum": ["matched", "unmatched", "excluded"]},
            "quality_flags": {"type": "array", "items": {"type": "string"}},
            "exclusion_reason": {"type": "string"}
          }
        }
      ]
    },
    "derivedEstimate": {
      "allOf": [
        {"$ref": "#/$defs/baseRecord"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["record_id", "record_type", "data_status", "source", "observed_at_utc", "input_record_ids", "claim_type", "estimate_type", "value", "uncertainty", "assumptions", "limitations"],
          "properties": {
            "record_id": {"type": "string"},
            "record_type": {"const": "derived_estimate"},
            "data_status": {"enum": ["observed", "synthetic"]},
            "source": {"$ref": "#/$defs/source"},
            "observed_at_utc": {"type": "string", "format": "date-time"},
            "input_record_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "claim_type": {"enum": ["pm_event_price_convention", "risk_neutral_probability", "bs_equivalent_iv"]},
            "estimate_type": {"type": "string"},
            "value": {"type": ["number", "object"]},
            "uncertainty": {"type": "object", "required": ["summary", "method"], "properties": {"summary": {"type": "string"}, "method": {"type": "string"}, "lower": {"type": ["number", "null"]}, "upper": {"type": ["number", "null"]}}},
            "assumptions": {
              "type": "object",
              "required": ["model", "model_version", "discounting", "rates", "dividends_or_carry", "interpolation", "tail", "code_commit"],
              "properties": {
                "model": {"type": "string"}, "model_version": {"type": "string"},
                "discounting": {"type": "string"}, "rates": {"type": "string"},
                "dividends_or_carry": {"type": "string"}, "interpolation": {"type": "string"},
                "tail": {"type": "string"}, "code_commit": {"type": "string"}
              }
            },
            "limitations": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_version", "dataset_id", "dataset_version", "source", "collected_at_utc", "event_time_start_utc", "event_time_end_utc", "settlement_timezone", "transformations", "artifact", "storage_uri", "code_commit", "synthetic_fixture"],
      "properties": {
        "manifest_version": {"const": "1.0.0"},
        "dataset_id": {"type": "string"}, "dataset_version": {"type": "string"},
        "source": {"$ref": "#/$defs/source"},
        "collected_at_utc": {"type": "string", "format": "date-time"},
        "event_time_start_utc": {"type": "string", "format": "date-time"},
        "event_time_end_utc": {"type": "string", "format": "date-time"},
        "settlement_timezone": {"type": "string"},
        "transformations": {"type": "array", "items": {"type": "object", "required": ["name", "version", "parameters"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "parameters": {"type": "object"}, "parent_dataset_ids": {"type": "array", "items": {"type": "string"}}}}},
        "artifact": {"type": "object", "required": ["path", "format", "row_count", "byte_count", "sha256"], "properties": {"path": {"type": "string"}, "format": {"type": "string"}, "row_count": {"type": "integer", "minimum": 0}, "byte_count": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
        "storage_uri": {"type": "string"}, "code_commit": {"type": "string"},
        "synthetic_fixture": {"type": "boolean"}
      }
    }
  }
}
